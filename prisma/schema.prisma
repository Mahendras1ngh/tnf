// Prisma Schema for TheNextFrame.in
// Media Production Company Website

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (runtime)
  directUrl = env("DIRECT_URL")   // direct connection (migrations)
}

// ============================================
// Authentication & Users
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  posts    BlogPost[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  ADMIN
  EDITOR
}

// ============================================
// Services
// ============================================

model Service {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  description     String          @db.Text
  icon            String?         // Lucide icon name
  image           String?
  content         Json?           // Rich content blocks (intro, sections, faqs)
  features        String[]        // Array of feature strings
  tags            String[]        // Service tags
  category        ServiceCategory @default(FILM_BRAND)
  investment      String?         // Price range e.g. "₹8-25L"
  turnaround      String?         // Time range e.g. "4-8 weeks"
  metaTitle       String?         // SEO <title>
  metaDescription String?         @db.Text // SEO meta description
  heroSubtitle    String?         @db.Text // Short hero intro line
  order           Int             @default(0)
  isActive        Boolean         @default(true)
  isListed        Boolean         @default(true) // Show in main /services grid (false = SEO landing only)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  portfolioItems PortfolioItem[]

  @@map("services")
}

enum ServiceCategory {
  FILM_BRAND
  PERFORMANCE_SOCIAL
  ADJACENT_CRAFTS
}

// ============================================
// Portfolio
// ============================================

model PortfolioItem {
  id           String            @id @default(cuid())
  title        String
  slug         String            @unique
  description  String            @db.Text
  thumbnail    String?
  videoUrl     String?           // YouTube/Vimeo URL
  images       String[]          // Gallery images
  client       String?
  category     PortfolioCategory
  tags         String[]
  featured     Boolean           @default(false)
  order        Int               @default(0)
  isActive     Boolean           @default(true)
  completedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("portfolio_items")
}

enum PortfolioCategory {
  COMMERCIAL
  CORPORATE
  MUSIC_VIDEO
  DOCUMENTARY
  SHORT_FILM
  WEDDING
  EVENT
  SOCIAL_MEDIA
  ANIMATION
  OTHER
}

// ============================================
// Blog
// ============================================

model BlogPost {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String     @db.Text
  content     String     @db.Text // MDX content
  coverImage  String?
  tags        String[]
  category    String?
  readTime    Int?       // Minutes
  published   Boolean    @default(false)
  featured    Boolean    @default(false)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("blog_posts")
}

// ============================================
// Team Members
// ============================================

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String?  @db.Text
  image     String?
  email     String?
  phone     String?
  linkedin  String?
  twitter   String?
  instagram String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("team_members")
}

// ============================================
// Testimonials
// ============================================

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String?
  company   String?
  content   String   @db.Text
  image     String?
  rating    Int      @default(5) // 1-5 stars
  videoUrl  String?  // Video testimonial URL
  featured  Boolean  @default(false)
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("testimonials")
}

// ============================================
// FAQs
// ============================================

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

// ============================================
// Contact Submissions
// ============================================

model ContactSubmission {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  subject   String?
  message   String        @db.Text
  service   String?       // Interested service
  budget    String?
  status    ContactStatus @default(NEW)
  notes     String?       @db.Text // Admin notes
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contact_submissions")
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

// ============================================
// Site Settings
// ============================================

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string") // string, number, boolean, json
  group     String?  // general, contact, social, seo
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ============================================
// Client Logos
// ============================================

model ClientLogo {
  id        String   @id @default(cuid())
  name      String
  logo      String
  website   String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("client_logos")
}

// ============================================
// Media Assets
// ============================================

model MediaAsset {
  id        String    @id @default(cuid())
  filename  String
  url       String
  type      MediaType
  size      Int?      // File size in bytes
  width     Int?
  height    Int?
  alt       String?
  caption   String?
  folder    String?   // Organizational folder
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("media_assets")
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}
